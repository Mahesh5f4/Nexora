# =============================================================
# Nexora — Example Environment Variables
# =============================================================
# Instructions:
#   1. Copy this file to `.env`
#   2. Replace the placeholder values with actual secrets
# =============================================================

# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── Qdrant ───────────────────────────────────────────────────
QDRANT_HTTP_PORT=6333

# ─── Backend Service ──────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nexora
SPRING_DATASOURCE_USERNAME=nexora
SPRING_DATASOURCE_PASSWORD=your_secure_db_password
SPRING_REDIS_URL=redis://redis:6379

# ─── AI Service ───────────────────────────────────────────────
LLM_API_KEY=your_openai_or_anthropic_api_key

# ─── Mail Configuration (Brevo SMTP) ─────────────────────────
SPRING_MAIL_USERNAME=your_brevo_smtp_email
SPRING_MAIL_PASSWORD=your_brevo_smtp_password
SPRING_MAIL_FROM=noreply@yourdomain.com
BREVO_API_KEY=your_brevo_api_key

# ─── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ─── Admin Account ────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password
