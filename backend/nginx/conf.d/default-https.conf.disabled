# =============================================================
# Nginx — HTTPS Server Block (Optional — Use After Let's Encrypt)
# =============================================================
# ACTIVATE ONLY after running: ./init-letsencrypt.sh yourdomain.com
#
# To activate:
#   1. Edit this file — replace YOUR_DOMAIN with your actual domain
#   2. mv nginx/conf.d/default.conf nginx/conf.d/default.conf.bak
#   3. cp nginx/conf.d/default-https.conf nginx/conf.d/default.conf
#   4. docker compose restart nginx
# =============================================================

# Replace YOUR_DOMAIN with your actual domain name (e.g., api.eventhub.com)
# ↓↓↓↓↓↓↓↓↓↓↓↓↓↓↓
# set $domain YOUR_DOMAIN;

upstream gateway {
    server gateway-service:8080;
    keepalive 32;
}

# ─── HTTP → HTTPS Redirect ────────────────────────────────────
server {
    listen 80;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    # Allow Certbot ACME challenge (Let's Encrypt renewal)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Redirect all other HTTP to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ─── HTTPS Server ─────────────────────────────────────────────
server {
    listen 443 ssl;
    http2  on;
    server_name YOUR_DOMAIN www.YOUR_DOMAIN;

    # ─── TLS Certificate (Let's Encrypt) ─────────────────────
    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/YOUR_DOMAIN/chain.pem;

    # ─── TLS Hardening ───────────────────────────────────────
    ssl_protocols               TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers   on;
    ssl_ciphers                 ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache           shared:SSL:10m;
    ssl_session_timeout         1d;
    ssl_session_tickets         off;
    ssl_stapling                on;
    ssl_stapling_verify         on;

    # ─── Security Headers ────────────────────────────────────
    add_header Strict-Transport-Security    "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options              "SAMEORIGIN"                    always;
    add_header X-XSS-Protection             "1; mode=block"                 always;
    add_header X-Content-Type-Options       "nosniff"                       always;
    add_header Referrer-Policy              "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy           "geolocation=(), microphone=()" always;

    # ─── Health Check ────────────────────────────────────────
    location = /health {
        access_log  off;
        return 200  "healthy\n";
        add_header  Content-Type text/plain;
    }

    # ─── WebSocket Support ───────────────────────────────────
    location /api/ws-booking/ {
        proxy_pass          http://gateway;
        proxy_http_version  1.1;
        proxy_set_header    Upgrade     $http_upgrade;
        proxy_set_header    Connection  "upgrade";
        proxy_set_header    Host        $host;
        proxy_set_header    X-Real-IP   $remote_addr;
        proxy_set_header    X-Forwarded-For  $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto $scheme;
        proxy_read_timeout  86400s;
    }

    # ─── All API Traffic ─────────────────────────────────────
    location / {
        limit_req   zone=api burst=50 nodelay;
        limit_conn  conn_limit 20;

        proxy_pass          http://gateway;
        proxy_http_version  1.1;
        proxy_set_header    Host                $host;
        proxy_set_header    X-Real-IP           $remote_addr;
        proxy_set_header    X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto   $scheme;
        proxy_set_header    Connection          "";
        proxy_connect_timeout   60s;
        proxy_send_timeout      60s;
        proxy_read_timeout      60s;
        proxy_buffering         on;
        proxy_buffer_size       4k;
        proxy_buffers           8 4k;
    }
}
